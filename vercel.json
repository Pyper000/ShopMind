{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "frontend/",
      "framework": "vite",
      "buildCommand": "npm ci && npm run build",
      "outputDirectory": "dist"
    },
    "agent": {
      "root": "./",
      "framework": "fastapi",
      "entrypoint": "vercel_app:app",
      "functions": {
        "vercel_app.py": {
          "maxDuration": 300
        }
      }
    }
  },
  "rewrites": [
    { "source": "/commerce", "destination": { "service": "agent" } },
    { "source": "/commerce/(.*)", "destination": { "service": "agent" } },
    { "source": "/health", "destination": { "service": "agent" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
